# Copy to Backend/.env and fill in real values. Never commit Backend/.env.
PORT=3000

# Oracle (academic data). Use a read-only account when possible.
DB_USER=
DB_PASSWORD=
DB_CONNECTION_STRING=

# EXP_LEVELID values to include (comma-separated). 1 = ปริญญาตรี. Default: 1
# CLASS_LEVEL_IDS=1

# Groq (AI replies)
GROQ_API_KEY=
# GROQ_MODEL=

# Supabase (AI Advisor reads the signed-in student's profile).
# Same project URL as Frontend/auth.js, origin only, e.g. https://<project-ref>.supabase.co
SUPABASE_URL=
# Publishable key (sb_publishable_...) or legacy anon key.
# Never use the service_role / sb_secret_ key here; the backend rejects it.
SUPABASE_PUBLISHABLE_KEY=
